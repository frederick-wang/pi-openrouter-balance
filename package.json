{
  "name": "pi-openrouter-balance",
  "version": "0.1.1",
  "description": "OpenRouter account balance and key usage in the pi footer — balance, per-key limits, period spends, burn rate, /openrouter-balance report. Unofficial, not affiliated with OpenRouter.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "openrouter",
    "balance",
    "usage",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederick-wang/pi-openrouter-balance.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "extensions",
    "README.zh-CN.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.ts'",
    "live-check": "node scripts/live-check.ts"
  },
  "packageManager": "pnpm@11.24.0"
}
